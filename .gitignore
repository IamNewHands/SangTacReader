# Xcode
build/
DerivedData/
*.ipa
*.xcuserstate
xcuserdata/

# Capacitor / Node
node_modules/
.capacitor/
dist-ipa/
# ios/ 平台目录由 macOS 上的 `npx cap add ios` 生成（Windows 生成会写坏
# CapApp-SPM/Package.swift 的路径），因此不入库。
ios/App/build/
ios/App/Pods/
ios/App/App/public/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/

# Temp analysis
apk_extracted/
error.txt
*.apk
*_Build*.txt
inspect_*.js
find_*.js
script10.js
app.v2*.js
app_v2*.html
stv.ui.js
download_assets.js

# 反编译/调试临时产物（不提交，体积大）
_*/
_*.py
_*.txt
_*.js
_*.html
_*.css
_*.zip
_*.json
log.txt
jdk17.zip
jdk17_dir/
*脚本.js

# 抓取/调试产物
online_*.js
app_v2_local.js

# 随包的站点资源镜像（plugins/app/.../site-assets/）是**故意入库**的：它就是站点那 8 个
# 前端 bundle，随 IPA 发布，运行时还会按 Last-Modified 与站点核对。上面的 `app.v2*.js`
# 是为了挡掉反编/调试时下载的临时副本，却会把镜像里的 6 个文件一起吃掉，所以这里显式放行
# （后面的规则优先，且这些文件的父目录没有被排除，所以否定规则有效）。
!plugins/app/ios/Sources/SangTacAppPlugin/site-assets/
!plugins/app/ios/Sources/SangTacAppPlugin/site-assets/**
